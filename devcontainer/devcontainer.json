{
  "name": "FieldOps Dev",
  "dockerComposeFile": [
    "../fieldops-backend/docker-compose.yml",
    "docker-compose.yml"
  ],
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },

  // Dentro del Codespace, Postgres y Redis se llaman por el nombre del
  // servicio de docker-compose ("postgres"/"redis"), no "localhost" —
  // esto override-ea appsettings.json sin tener que tocarlo (así el
  // mismo appsettings.json sigue sirviendo para correr localmente en
  // Windows con Docker Desktop, donde sí es "localhost").
  "containerEnv": {
    "ConnectionStrings__Postgres": "Host=postgres;Database=fieldops;Username=fieldops;Password=changeme",
    "ConnectionStrings__Redis": "redis:6379"
  },

  "forwardPorts": [3000, 5000, 5432, 6379],
  "portsAttributes": {
    "3000": { "label": "Frontend (Next.js)" },
    "5000": { "label": "Backend (.NET API)" }
  },

  "postCreateCommand": "dotnet --version && node --version && echo 'Codespace listo.'"
}
